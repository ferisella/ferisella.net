  path="/"
  ogType="profile"
  ogTitle="Fer Isella · Entre el piano y el código"
  ogDescription="Pianista y compositor nominado al Latin Grammy. My Father's Heart, My Heart, The Piano Label. Cofundador de limbo/, infraestructura para la música independiente. Madrid."
>
  <Fragment slot="head">
    <meta property="profile:first_name" content="Fer">
    <meta property="profile:last_name" content="Isella">
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
  </Fragment>
  <HomeContent lang="es" />
</Base>
