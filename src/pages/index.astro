---
import Base from '../layouts/Base.astro';
import HomeContent from '../components/HomeContent.astro';
import { personSchema } from '../lib/schema';
---

<Base
  lang="en"
  title="Fer Isella · Pianist and composer. Piano and code."
  description="Latin Grammy-nominated pianist and composer. Author of My Father's Heart and My Heart, released on The Piano Label. Co-founder of limbo/, independent music infrastructure. Based in Madrid."
  path="/"
  ogType="profile"
  ogTitle="Fer Isella · Between the piano and the code"
  ogDescription="Latin Grammy-nominated pianist and composer. My Father's Heart, My Heart, The Piano Label. Co-founder of limbo/, independent music infrastructure. Madrid."
>
  <Fragment slot="head">
    <script is:inline>
      // Primera visita con navegador en español y sin preferencia guardada:
      // ir a la versión en español. La preferencia se guarda al usar el toggle.
      (function () {
        try {
          var raw = localStorage.getItem('lang-pref') || localStorage.getItem('lang');
          var pref = raw ? raw.toLowerCase() : null;
          var wantsEs = pref === 'es' || (!pref && (navigator.language || '').toLowerCase().indexOf('es') === 0);
          if (wantsEs) location.replace('/es/' + location.hash);
        } catch (e) {}
      })();
    </script>
    <meta property="profile:first_name" content="Fer">
    <meta property="profile:last_name" content="Isella">
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
  </Fragment>
  <HomeContent lang="en" />
</Base>
